$ docker exec 2d565ddd25b145a50539c575f6a9714dc71a51718371db0603f5313277d971a7 node -e async function check(){for(let i=0;i<30;i++){try{const r=await fetch('http://127.0.0.1:3000');if(r.status===200&&(await r.json()).message==='Hello from toy Express TypeScript app!')return;}catch{}await new Promise(r=>setTimeout(r,100));}process.exit(1)}check()
